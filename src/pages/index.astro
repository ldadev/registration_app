---
import Layout from '../layouts/Layout.astro';
---

<Layout>

  <div id="imageCarousel" class="carousel slide" data-bs-ride="carousel">
    
    <div class="carousel-inner h-100">
      <div class="carousel-item active h-100">
        <img src={import.meta.env.BASE_URL + 'img/doctor-sonriente-de-la-vista-lateral-que-consulta-un-paciente.webp'} class="d-block w-100 h-100 object-fit-cover' class="d-block w-100 h-100 object-fit-cover" alt="Imagen 1">

      </div>
      <div class="carousel-item h-100">
        <img src={import.meta.env.BASE_URL + 'img/joven-medico-apoyando-su-paciente.webp'} class="d-block w-100 h-100 object-fit-cover" class="d-block w-100 h-100 object-fit-cover" alt="Imagen 2">
      </div>
      <div class="carousel-item h-100">
        <img src={import.meta.env.BASE_URL + 'img/cirujano-feliz-y-anciana-estrechando-la-mano-mientras-saludan-en-el-vestibulo-de-la-clinica-el-foco-esta-en-la-mujer.webp'} class="d-block w-100 h-100 object-fit-cover" alt="Imagen 3">
      </div>
    </div>

    <div class="carousel-banner text-white p-3 text-center position-absolute w-100">
      <h1 id="bannerTitle">Bienvenido al Servicio de salud</h1>
      <p id="bannerText" class="lead">¡Nos gusta tenerte por aca!</p>
    </div>

    <button class="carousel-control-prev" type="button" data-bs-target="#imageCarousel" data-bs-slide="prev">
      <span class="carousel-control-prev-icon" aria-hidden="true"></span>
      <span class="visually-hidden">Anterior</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#imageCarousel" data-bs-slide="next">
      <span class="carousel-control-next-icon" aria-hidden="true"></span>
      <span class="visually-hidden">Siguiente</span>
    </button>
  </div>
  <button 
    class="btn btn-primary position-absolute top-0 end-0 m-4 px-4 py-2 fw-semibold d-none d-md-block"
    data-bs-toggle="modal" 
    data-bs-target="#registroModal"
    style="z-index:1055;">
    Registrarse
  </button>
  <div class="modal fade" id="registroModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog" style="max-width: 700px;"> 

      <div class="modal-content border-0 shadow">

        <div class="modal-body p-4">

          <div class="form-header text-center mb-4">
            <img src={import.meta.env.BASE_URL + 'img/welcome.png'} alt="Bienvenido" class="form-icon">
            <h2 id="formStepTitle" class="fs-4 mt-3">Registrarse</h2>
          </div>

          
          <form id="userForm" class="card border-0 shadow-sm p-3 p-md-4">

            <div class="step active" id="step1">
              <div class="row g-3">
                <div class="col-md-6">
                  <label class="form-label">Tipo Documento</label>
                  <select class="form-select" name="tipoDocumento" required>
                    <option value="">Seleccione...</option>
                    <option value="CC">Cédula de Ciudadanía</option>
                    <option value="CE">Cédula de Extranjería</option>
                    <option value="TI">Tarjeta de Identidad</option>
                    <option value="PA">Pasaporte</option>
                  </select>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Documento</label>
                  <input type="text" name="documento" class="form-control" required inputmode="numeric">
                </div>
                <div class="col-md-6">
                  <label class="form-label">Primer Nombre</label>
                  <input type="text" name="primerNombre" class="form-control" required>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Segundo Nombre</label>
                  <input type="text" name="segundoNombre" class="form-control">
                </div>
                <div class="col-md-6">
                  <label class="form-label">Primer Apellido</label>
                  <input type="text" name="primerApellido" class="form-control" required>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Segundo Apellido</label>
                  <input type="text" name="segundoApellido" class="form-control">
                </div>
                <div class="col-12">
                  <label class="form-label">Sexo</label>
                  <select class="form-select" name="sexo" required>
                    <option value="">Seleccione...</option>
                    <option>Masculino</option>
                    <option>Femenino</option>
                    <option>Otro</option>
                  </select>
                </div>
              </div>
            </div>

            <div class="step" id="step2">
              <div class="row g-3">
                <div class="col-md-12">
                  <label class="form-label">País</label>
                  <input type="text" name="pais" class="form-control" value="Colombia">
                </div>
                <div class="col-md-6">
                  <label class="form-label">Departamento</label>
                  <select id="departamentoSelect" name="departamento" class="form-select" required>
                    <option value="">Cargando...</option>
                  </select>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Municipio</label>
                  <select id="municipioSelect" name="ciudad" class="form-select" required>
                    <option value="">Seleccione departamento primero</option>
                  </select>
                </div>
                <div class="col-md-12">
                  <label class="form-label">Dirección</label>
                  <input type="text" name="direccion" class="form-control" required>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Teléfono</label>
                  <input type="text" name="telefono" class="form-control" inputmode="numeric">
                </div>
                <div class="col-md-6">
                  <label class="form-label">Celular</label>
                  <input type="text" name="celular" class="form-control" inputmode="numeric">
                </div>
                <div class="col-md-12">
                  <label class="form-label">Correo Personal</label>
                  <input type="email" name="correo" class="form-control" required>
                </div>
              </div>
            </div>

            <div class="step" id="step3">
              <div class="row g-3">
                <div class="col-md-6">
                  <label class="form-label">Tipo de perfil asistencial ó administrativo</label>
                  <select class="form-select" name="tipoProfesional" id="tipoProfesional" required>
                    <option value="">Cargando...</option>
                  </select>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Especialidad</label>
                  <select class="form-select" name="especialidad" id="especialidad" required>
                    <option value="">Cargando...</option>
                  </select>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Tarjeta Profesional</label>
                  <input type="text" name="tarjetaProfesional" class="form-control" inputmode="numeric">
                </div>
                <div class="col-md-6">
                  <label class="form-label">Institución de educación superior</label>
                  <input type="text" name="universidad" class="form-control" required>
                </div>
                <div class="col-md-12">
                  <label class="form-label">Registro de Salud Deptartamental</label>
                  <input type="text" name="registroSalud" class="form-control" inputmode="numeric">
                </div>
                <div class="col-md-12">
                  <label class="form-label">Observaciones</label>
                  <textarea name="observaciones" class="form-control"></textarea>
                </div>
              </div>
            </div>

            <div class="step" id="step4">
              <div class="row g-3">
                <div class="col-md-6">
                  <label class="form-label">Intensidad horaria del cargo a ocupar</label>
                  <input type="text" name="intensidadHoraria" class="form-control" required inputmode="numeric">
                </div>
                <div class="col-md-6">
                  <label class="form-label">Modalidad de Trabajo</label>
                  <select class="form-select" name="modalidadTrabajo" id="modalidadTrabajo" required>
                    <option value="">Seleccione...</option>
                    <option value="Presencial">Presencial</option>e
                    <option value="Remota">Remota</option>
                    <option value="Presencial y Remota">Presencial y Remota</option>
                  </select>
                </div>
                <div class="col-md-6 d-none" id="tipoVinculacionDiv">
                  <label class="form-label">Tipo de Vinculación</label>
                  <select class="form-select" name="tipoVinculacion" id="tipoVinculacion">
                    <option value="">Seleccione...</option>
                    <option value="Empleado Público">Empleado Público</option>
                    <option value="Empleado Público Provisional">Empleado Público Provisional</option>
                    <option value="Contratista">Contratista</option>
                  </select>
                </div>
                <div class="col-md-6 d-none" id="fechaInicioDiv">
                  <label class="form-label">Fecha Inicio Contrato</label>
                  <input type="date" name="fechaInicio" class="form-control">
                </div>
                <div class="col-md-6 d-none" id="fechaFinDiv">
                  <label class="form-label">Fecha Fin Contrato</label>
                  <input type="date" name="fechaFin" class="form-control">
                </div>
                <div class="col-md-6">
                  <label class="form-label">Estado Correo</label>
                  <select class="form-select" name="estadoCorreo" id="estadoCorreo" required>
                    <option value="">Seleccione...</option>
                    <option>Activo</option>
                    <option>Inactivo</option>
                    <option>En trámite</option>
                    <option>No tengo</option>
                  </select>
                </div>
                <div class="col-md-6 d-none" id="correoUnivalleDiv">
                  <label class="form-label">Correo Univalle</label>
                  <input type="email" name="correoUnivalle" id="correoUnivalle" class="form-control">
                </div>
              </div>
            </div>

            <div class="step" id="step5">
              <p class="text-muted">Dibuje su firma en el recuadro.</p>
              <canvas id="signature-pad" width="176" height="55" 
                style="width:100%; max-width:500px; height:200px; border: 1px solid #ccc; border-radius: 4px;">
              </canvas>
              <div class="mt-2">
                <button type="button" class="btn btn-secondary" id="clearSignature">Limpiar Firma</button>
              </div>
              <hr class="my-3">
              <label class="form-label">Subir Firma (opcional)</label>
              <input type="file" id="signatureFile" accept="image/*" class="form-control mb-2">
              <div id="signaturePreview" class="text-center mt-2"></div>
            </div>

          </form>
          </div>

        <div class="form-footer">
          <button type="button" class="btn btn-outline-secondary" id="prevBtn">Atrás</button>
          <button type="button" class="btn btn-primary" id="nextBtn">Siguiente</button>
          <button type="submit" form="userForm" class="btn btn-success d-none" id="submitBtn">Enviar</button>
        </div>
      
      </div> 
    </div> 
  </div> 
  <iframe id="gsheetFrame" name="gsheetFrame" style="display:none;"></iframe>

</Layout>